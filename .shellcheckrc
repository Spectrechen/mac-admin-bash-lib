# Repo-local ShellCheck configuration (overrides any global ~/.shellcheckrc).
# https://www.shellcheck.net/wiki/

# Look for 'source'd files relative to the current working directory.
source-path=.

# Allow opening any 'source'd file, even if not specified as input
external-sources=true

# SC2310: This function is invoked in an 'if' / ! condition so set -e will be
# disabled. Invoke separately if failures should cause the script to exit.
# We don't use the `set -e` feature in Bash scripts yet.
# Allow `if command` and `if ! command`.
disable=SC2310

# SC2311: Bash implicitly disabled set -e for this function invocation because
# it's inside a command substitution.
# We don't use the `set -e` feature in Bash scripts yet.
# Allow `var="$(command)"`.
disable=SC2311

# SC2312: Consider invoking this command separately to avoid masking its return
# value (or use '|| true' to ignore).
# We don't need return codes for "$(command)", only stdout is needed.
# Allow `var="$(command)"`, etc.
disable=SC2312

# SC2034: Variable appears unused (often exported or used indirectly).
# The `path` local in install/uninstall helpers is intentionally unused in some
# modules; silence the warning.
disable=SC2034

# SC2155: Declare and assign separately (common idiom, rarely causes issues).
disable=SC2155

# SC2295: Expansions inside ${..} need quoting (info-level, rarely causes issues).
disable=SC2295

# SC1012: \r is literal (tr -d '\r' works as intended on most systems).
disable=SC1012

# SC2026: Word outside quotes (info-level, often intentional).
disable=SC2026

# SC2016: Expressions don't expand in single quotes (often intentional in sed/awk).
disable=SC2016

# SC2129: Consider using { cmd1; cmd2; } >> file (style preference).
disable=SC2129
